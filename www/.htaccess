# ── Gzip / Deflate ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/plain
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|woff2?)$ no-gzip dont-vary
</IfModule>

# ── Browser caching ──────────────────────────────────────────────────────────
# JS/CSS are versioned via ?v=, so they can be cached for a long time.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png              "access plus 30 days"
    ExpiresByType image/x-icon           "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.pl$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ── Protect internal directories/files (flat layout: everything lives in one DocumentRoot) ──
Options -Indexes
# /mcp is both an endpoint and the directory of the MCP code: no redirect to /mcp/. Directory URLs are not used.
DirectorySlash Off
# pages/*.pl are CGI fragments: served directly, /pages/zones.pl would run without check_session.
# No [NC]: a case-insensitive 'API' would also match /api/ and forbid the whole REST API.
<IfModule mod_rewrite.c>
RewriteEngine on
RewriteRule ^(?:include|API|pages)(?:/|$) - [F,L]
RewriteRule ^mcp/ - [F,L]
# Any dot-path (.git, .claude, .env...): Options -Indexes does not stop direct reads of /.git/config. /.well-known/ is allowed.
# A deny-list is fragile; moving web entry points into a separate public/ would be the proper fix.
RewriteRule ^\.(?!well-known/) - [F,L]
</IfModule>
# Extra layer by extension (secrets, code, schemas, docs):
<FilesMatch "\.(json|sql|pm|md)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine on
RewriteBase /

# CGI and FastCGI do not get the Authorization header by default; external API and MCP clients send their token in it.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

<Files "*.pl">
    SetHandler cgi-script
    Options +ExecCGI
</Files>
# Pages and the API run in one persistent process (panel.fcgi). Without mod_fcgid the same script runs as
# plain CGI: FCGI.pm then serves exactly one request per start.
<Files "panel.fcgi">
    <IfModule mod_fcgid.c>
        SetHandler fcgid-script
    </IfModule>
    <IfModule !mod_fcgid.c>
        SetHandler cgi-script
    </IfModule>
    Options +ExecCGI
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </IfModule>
</Files>

RewriteRule ^$ /panel.fcgi [L]

RewriteRule ^login$  /login.pl  [L]
RewriteRule ^logout$ /logout.pl [L]

RewriteRule ^index$ / [R=301,L]

RewriteRule ^dashboard$ /panel.fcgi?page=dashboard [QSA,L]
RewriteRule ^zones$     /panel.fcgi?page=zones     [QSA,L]
RewriteRule ^labels$    /panel.fcgi?page=labels    [QSA,L]
RewriteRule ^propagation$  /panel.fcgi?page=propagation  [QSA,L]
RewriteRule ^pulse$        /panel.fcgi?page=pulse        [QSA,L]
RewriteRule ^ha$        /panel.fcgi?page=ha        [QSA,L]
RewriteRule ^records$   /panel.fcgi?page=records   [QSA,L]
RewriteRule ^audit$     /panel.fcgi?page=audit     [QSA,L]
RewriteRule ^settings$  /panel.fcgi?page=settings  [QSA,L]
RewriteRule ^account$   /panel.fcgi?page=account   [QSA,L]
RewriteRule ^documentation$ /panel.fcgi?page=documentation [QSA,L]

RewriteRule ^ajax/([^/]+)$ /panel.fcgi?page=$1&ajax=1 [QSA,L]

# LB/anycast health probes on short root paths go to the API (no session/CSRF there).
RewriteRule ^health/(live|ready)$ panel.fcgi [L]

# Prefix is /dns-api/, not /api/: on this host /api is proxied to Starman (127.0.0.1:5000) and would catch everything.
RewriteRule ^dns-api/(.*)$ panel.fcgi [L]

# Remote MCP (Streamable HTTP) and its OAuth resource metadata, both served by mcp/http.pl inside panel.fcgi.
RewriteRule ^mcp$ panel.fcgi [L]
RewriteRule ^\.well-known/oauth-protected-resource$ panel.fcgi [L]

# Anything else that is not an existing file or directory -> 404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule .* /404.pl [L]
</IfModule>

ServerSignature Off
AddDefaultCharset UTF-8

<Files "*.pl">
    SetHandler cgi-script
    Options +ExecCGI
</Files>
Options +ExecCGI
AddHandler cgi-script .pl
