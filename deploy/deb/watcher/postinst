#!/bin/sh
set -e
CONF=/opt/dns-panel/etc/dns-watcher.toml
case "$1" in
    configure)
        ln -sf /opt/dns-panel/etc/systemd/dns-watcher.service /etc/systemd/system/dns-watcher.service
        systemctl daemon-reload
        systemctl enable -q dns-watcher
        if [ -s "$CONF" ]; then
            systemctl restart dns-watcher
            echo "dns-watcher is running: journalctl -u dns-watcher -n 5"
        else
            echo "dns-watcher is installed. Next:"
            echo "  1. cp /opt/dns-panel/etc/dns-watcher.example.toml $CONF and set the service address and the two nodes"
            echo "  2. systemctl start dns-watcher"
        fi ;;
esac
exit 0
