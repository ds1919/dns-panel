#!/bin/sh
set -e
CONF=/opt/dns-panel/etc/pulse-agent.toml
case "$1" in
    configure)
        id pulse-agent >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin pulse-agent
        ln -sf /opt/dns-panel/etc/systemd/pulse-agent.service /etc/systemd/system/pulse-agent.service
        systemctl daemon-reload
        systemctl enable -q pulse-agent
        if [ -s "$CONF" ]; then
            systemctl restart pulse-agent
            echo "pulse-agent is running; its request code: journalctl -u pulse-agent -n 5"
        else
            echo "pulse-agent is installed. Next:"
            echo "  1. paste the file from the panel (NS Pulse -> Agent config) into $CONF"
            echo "  2. systemctl start pulse-agent"
            echo "  3. approve the request in the panel (NS Pulse -> Waiting for approval); its code: journalctl -u pulse-agent -n 5"
        fi ;;
esac
exit 0
